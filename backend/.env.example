PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="mysql://root@localhost:3306/live_chat"
UPLOAD_DIR=uploads
MAX_IMAGE_MB=15
MAX_VIDEO_MB=100
# First-run admin for the operator portal (only used when no operators exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin
# JWT signing secret: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
OPERATOR_TOKEN_TTL=12h
CUSTOMER_TOKEN_TTL=30d
