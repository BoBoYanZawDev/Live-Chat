# Backend base URL for the customer app (no trailing slash).
# Leave empty in local dev: the app uses the IP of the machine running Expo, port 4000
# (e.g. http://10.103.6.60:4000), so it keeps working when your Wi-Fi IP changes.
# Set it when using `npx expo start --tunnel`, a staging/production server, or a backend on another machine:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:4000
#   EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# Restart Expo after changing this file (npx expo start -c).
EXPO_PUBLIC_API_URL=
